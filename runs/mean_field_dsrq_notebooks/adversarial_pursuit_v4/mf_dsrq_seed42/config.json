  "gamma": 0.95,
  "lr": 0.0001,
  "batch_size": 64,
  "buffer_capacity": 200000,
  "learning_starts": 1000,
  "train_every": 4,
  "target_tau": 0.005,
  "grad_clip": 10.0,
  "ema_momentum": 0.5,
  "total_steps": 20000,
  "num_envs": 2,
  "seed": 42,
  "output_dir": "/home/wowthecoder/SRE-DQN/runs/mean_field_dsrq_notebooks",
  "log_interval": 1000,
  "save_interval": 20000,
  "use_gpu": true
