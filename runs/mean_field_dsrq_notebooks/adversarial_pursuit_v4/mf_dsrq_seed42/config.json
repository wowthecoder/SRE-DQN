{
  "env_name": "adversarial_pursuit_v4",
  "env_backend": "magent2",
  "map_size": 16,
  "max_cycles": 100,
  "type_prefixes": {
    "predator": "predator_",
    "prey": "prey_"
  },
  "n_nbr_actions_override": {
    "predator": 13,
    "prey": 9
  },
  "epsilon_tv_start": 0.1,
  "epsilon_tv_end": 0.02,
  "epsilon_tv_decay_frac": 1.0,
  "beta_start": 1.0,
  "beta_end": 5.0,
  "beta_anneal_frac": 0.5,
  "epsilon_explore_start": 1.0,
  "epsilon_explore_end": 0.05,
